{
  "$defs": {
    "Evidence": {
      "properties": {
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "start_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start S"
        },
        "end_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End S"
        },
        "media_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Sha256"
        }
      },
      "required": [
        "locator"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Observation": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "domain": {
          "enum": [
            "visual",
            "voice",
            "marketing",
            "narrative"
          ],
          "title": "Domain",
          "type": "string"
        },
        "value": {
          "title": "Value"
        },
        "basis": {
          "enum": [
            "source_description",
            "video_observation",
            "acoustic_measurement",
            "model_inference"
          ],
          "title": "Basis",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "uncertainty": {
          "default": "",
          "title": "Uncertainty",
          "type": "string"
        }
      },
      "required": [
        "id",
        "domain",
        "value",
        "basis",
        "confidence",
        "evidence"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Source": {
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "origin_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Url"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "rights_note": {
          "title": "Rights Note",
          "type": "string"
        },
        "analysis_access": {
          "enum": [
            "metadata_only",
            "sampled_frames",
            "full_video"
          ],
          "title": "Analysis Access",
          "type": "string"
        },
        "media_authorized": {
          "default": false,
          "title": "Media Authorized",
          "type": "boolean"
        },
        "authorization_evidence": {
          "default": "",
          "title": "Authorization Evidence",
          "type": "string"
        },
        "verification_date": {
          "title": "Verification Date",
          "type": "string"
        },
        "downloaded": {
          "default": false,
          "title": "Downloaded",
          "type": "boolean"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Path"
        }
      },
      "required": [
        "url",
        "license",
        "rights_note",
        "analysis_access",
        "verification_date"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "reference_id": {
      "pattern": "^[a-zA-Z0-9_-]+$",
      "title": "Reference Id",
      "type": "string"
    },
    "category": {
      "enum": [
        "ugc_presenter",
        "premium_beauty",
        "premium_fashion",
        "storytelling",
        "product_demo"
      ],
      "title": "Category",
      "type": "string"
    },
    "brand": {
      "title": "Brand",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "publication_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Date"
    },
    "publication_date_basis": {
      "default": "unknown",
      "title": "Publication Date Basis",
      "type": "string"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Seconds"
    },
    "duration_basis": {
      "default": "unknown",
      "title": "Duration Basis",
      "type": "string"
    },
    "platform": {
      "title": "Platform",
      "type": "string"
    },
    "format": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Format"
    },
    "ad_type": {
      "title": "Ad Type",
      "type": "string"
    },
    "concept": {
      "title": "Concept",
      "type": "string"
    },
    "hook": {
      "additionalProperties": true,
      "title": "Hook",
      "type": "object"
    },
    "narrative": {
      "additionalProperties": true,
      "title": "Narrative",
      "type": "object"
    },
    "commercial_message": {
      "title": "Commercial Message",
      "type": "string"
    },
    "editing_style": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Editing Style"
    },
    "dialogue_present": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dialogue Present"
    },
    "voice": {
      "additionalProperties": true,
      "title": "Voice",
      "type": "object"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "reference_id",
    "category",
    "brand",
    "title",
    "source",
    "platform",
    "ad_type",
    "concept",
    "commercial_message"
  ],
  "title": "Reference",
  "type": "object"
}
