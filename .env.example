# ---------------------------------------------------------------------------
# Premium Video Studio — configuration
# Copier en .env puis adapter. Aucune valeur n'est obligatoire pour démarrer :
# l'application tourne, l'UI s'ouvre, les jobs passent en simulation contrôlée.
# ---------------------------------------------------------------------------

# HTTP
PVS_HOST=0.0.0.0
PVS_PORT=8000
# 1 worker = 1 job GPU à la fois. Monter à 2 seulement avec 2 GPU.
PVS_MAX_WORKERS=1
PVS_DATA_DIR=./data

# Simulation (plaques de test, jamais présentées comme de l'IA).
# Passer à 0 en production : un job échouera au lieu de mentir.
PVS_ALLOW_MOCK=1

# --- Directeur créatif (LLM OpenAI-compatible) ------------------------------
# DeepSeek par défaut. Sans clé : le directeur utilise son template local.
PVS_LLM_BASE_URL=https://api.deepseek.com/v1
PVS_LLM_MODEL=deepseek-chat
PVS_LLM_API_KEY=

# --- GPU / moteurs ----------------------------------------------------------
# local | runpod | modal | vast   (sert au calcul de coût, pas à l'exécution)
PVS_PROVIDER=local

# Moteurs distants du nouveau studio. Identifiants Modal uniquement côté serveur.
PVS_MODAL_ENABLED=0
# python scripts/run_modal_studio.py active Modal, désactive les simulations,
# et sert l'interface sur http://127.0.0.1:8787 avec un seul worker.

# LTX-2.5 (vitesse + qualité des plans cinématographiques)
PVS_LTX_PYTHON=/opt/LTX-2/.venv/bin/python
PVS_LTX_REPO=/opt/LTX-2
PVS_LTX_MODELS=/models/ltx-2.5
PVS_LTX_PIPELINE=dfr            # dfr | distilled | two_stages

# Avatar parlant (LongCat-Video-Avatar 1.5)
PVS_AVATAR_PYTHON=python
PVS_AVATAR_REPO=/opt/LongCat-Video
PVS_AVATAR_WEIGHTS=/models/LongCat-Video-Avatar-1.5

# Voix (Chatterbox / VoxCPM2)
PVS_TTS_PYTHON=/opt/tts-venv/bin/python

# ComfyUI (backend d'exécution optionnel)
PVS_COMFY_URL=

# ffmpeg (sinon: .tools/ff/bin/ffmpeg, PATH, ou imageio-ffmpeg)
PVS_FFMPEG=

# --- Tarifs pour le calcul de coût (USD / heure GPU) ------------------------
PVS_RATE_RUNPOD_A100_80GB=1.39
PVS_RATE_RUNPOD_H100_80GB=2.89
PVS_RATE_RUNPOD_RTX_4090=0.69
